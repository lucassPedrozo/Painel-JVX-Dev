# Frontend (deixe vazio para detecção automática via IP da rede)
# VITE_API_URL=http://localhost:3001

# Backend
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
JWT_SECRET=sua-chave-secreta-aqui-min-32-caracteres
# Aceita lista separada por vírgula. Adicione http://SEU-IP:5173 para acesso na rede.
CORS_ORIGIN=http://localhost:5173
# Cookie de sessão só via HTTPS (padrão: true em produção). Use false apenas se servir por HTTP na rede interna.
# COOKIE_SECURE=true

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=worksdb
